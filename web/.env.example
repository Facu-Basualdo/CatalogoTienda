# Copiá este archivo a .env (o .env.local) y completá los valores.
# Supabase → Project Settings → API Keys / Data API.

# Públicas: viajan al navegador. La protección es RLS, no el secreto de estas claves.
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# URL canónica del sitio (metadata, sitemap, Open Graph). En local: http://localhost:3000
NEXT_PUBLIC_SITIO_URL=http://localhost:3000

# Número de WhatsApp para el botón de contacto, formato internacional sin "+" ni espacios.
NEXT_PUBLIC_WHATSAPP=5491100000000

# Sólo local, para la CLI de Supabase (migraciones). NUNCA en Vercel.
# Supabase → Connect → Session pooler (puerto 5432).
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
